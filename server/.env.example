# Copy this file to `.env` in the server directory and adjust values.
# E2E tests (`yarn test:e2e`) import AppModule and require MongoDB to be
# reachable at MONGODB_URI (same as the running app).

MONGODB_URI=mongodb://127.0.0.1:27017/neutral-tex
PORT=3000

# Redis (BullMQ + pipeline event bridge)
# Local dev: keep Redis on the same machine as the API (127.0.0.1). Do not point at a
# shared/staging Redis while MONGODB_URI is local — remote workers will consume jobs and
# your pipeline nodes will stay "pending" in local MongoDB.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Required when Redis has AUTH; also used to build REDIS_URL for pub/sub if unset
REDIS_PASSWORD=
# Optional override (full URL). When set, REDIS_HOST/PORT/PASSWORD are ignored for connections.
# REDIS_URL=redis://:yourPassword@192.168.0.242:6379
ORCHESTRATION_USE_QUEUE=true
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=2
QUEUE_RETRY_DELAY_MS=3000
ORCHESTRATION_USE_GRAPH=true
VIDEO_GENERATE_CONCURRENCY=3
VIDEO_CHECK_CONCURRENCY=10
VIDEO_POLL_INITIAL_DELAY_MS=60000
VIDEO_POLL_INTERVAL_MS=30000
VIDEO_POLL_MAX_CHECKS=58
RUN_WORKERS_IN_API=true
PIPELINE_EVENTS_BRIDGE=true
MAX_MATERIALIZED_LANES=10
LANE_SCOPED_PAUSE=false
ANALYTICS_AUTO_SUGGEST_AFTER_PULL=false
ANALYTICS_MIN_POSTS_FOR_AUTO_SUGGEST=3
SCHEDULER_MAX_CONCURRENT_PER_USER=2
# Not fully wired in app code yet; keep false unless you run bucket workers fleet-wide.
QUEUE_TENANT_ISOLATION=false
QUEUE_TENANT_BUCKETS=64
CAMPAIGN_AUTONOMY_ENABLED=false

# NewsData.io (news auto-generate cron)
NEWSDATA_API_KEY=
NEWS_TRIGGER_CONCURRENCY=3

# Default provider when node config does not set `config.provider`.
LLM_PROVIDER=openai

# OpenAI (LangChain/OpenAI SDK)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Presenter video script rewrite when copy exceeds duration budget (defaults to gpt-4o-mini)
SCRIPT_REWRITE_OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google (Gemini)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# Groq (OpenAI-compatible API)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local/self-hosted)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1


FILE_SERVICE_URL=http://192.168.0.242:4001/api/file/v1
# With FILE_SERVICE_URL + APP_URL (or PUBLIC_URL), use stable public media URLs:
#   POST /api/v1/image/file → response may include imageProxyUrl = {APP_URL}/api/v1/image/file?image={relativePath}
#   GET /api/v1/image/file?image={relativePath} streams from file-service (no ./uploads mirror needed for this path).
# Optional public hostname (e.g. ngrok). Used as fallback when APP_URL is unset for /upload media URLs.
PUBLIC_URL=https://snarly-anika-retrogradely.ngrok-free.dev

ZERNIO_API_KEY=your_zernio_api_key_here
ZERNIO_MCP_URL=https://mcp.zernio.com/mcp
# Skip MCP connect at startup (local dev without Zernio). Publish/analytics via MCP will not work.
# ZERNIO_MCP_DISABLED=true
# Optional: MCP tool name for scheduled-post reconciliation (default posts_get). Verify with GET /mcp/tools.
ZERNIO_MCP_GET_POST_TOOL=
# Cron: reconcile scheduled Zernio channels every 30m (true unless false/0).
ZERNIO_SCHEDULED_SYNC_ENABLED=true
ZERNIO_SCHEDULED_SYNC_UPLOAD_BATCH=300
ZERNIO_SCHEDULED_SYNC_MCP_CONCURRENCY=5
# When ZERNIO_SYNC_INSTANCE_ID is set, only one replica should hold the Mongo lease in sync_locks.
ZERNIO_SYNC_INSTANCE_ID=
ZERNIO_SCHEDULED_SYNC_LOCK_LEASE_MS=300000
# Analytics weekly cron: Mongo lease in sync_locks (analytics_weekly_pull); default 10 minutes.
ANALYTICS_WEEKLY_PULL_LOCK_LEASE_MS=600000
# Public base URL of this API (webhooks: `${APP_URL}/webhooks/zernio`; resolving relative media paths for Zernio publish when FILE_SERVICE_URL is internal).
APP_URL=https://snarly-anika-retrogradely.ngrok-free.dev
# Zernio REST publish uploads media via Zernio presigned URLs (`POST /v1/media/presign` + PUT), not via this server’s `/uploads`.
# When true (recommended with ngrok): after FILE_SERVICE_URL upload, mirror into ./uploads and return APP_URL (or PUBLIC_URL) + /uploads/... for app-facing URLs and workflow-generated assets.
UPLOAD_MEDIA_MIRROR_TO_LOCAL=true
# Local-only dev: leave FILE_SERVICE_URL empty and set APP_URL (or PUBLIC_URL); POST /upload/media writes directly to ./uploads and returns that base + /uploads/... (no file service).
# Must match the secret configured in Zernio; used to verify X-Zernio-Signature (HMAC-SHA256 over raw JSON body).
ZERNIO_WEBHOOK_SECRET=


FRONTEND_URL=http://localhost:5173

# --- Authorize Server (LCN SSO) ---
# Skip JWT verification (local/dev): impersonate Mongo user by authServerUserId. No Bearer required.
SSO_AUTH_DISABLED=false
DEV_IMPERSONATE_AUTH_SERVER_USER_ID=

SSO_BASE_URL=https://api-auths.laconic.co.th
SSO_APPLICATION_CODE=neutral-tex
# Optional; if unset we default to ${SSO_BASE_URL}/v1/lcn-sso/auth/jwks.json
SSO_JWKS_URL=

# Comma-separated UUIDs from authorize-server to mark as ADMIN locally.
ADMIN_BOOTSTRAP_AUTH_SERVER_USER_IDS=

# Default admin seeder (local Mongo user)
DEFAULT_ADMIN_ENABLED=false
DEFAULT_ADMIN_AUTH_SERVER_USER_ID=
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_FIRST_NAME=Admin
DEFAULT_ADMIN_LAST_NAME=Laconic

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs


# HeyGen Photo Avatar presenter videos (video_generation node, mode=presenter).
# Requires a public APP_URL (or PUBLIC_URL) for POST /webhooks/heygen callbacks.
HEYGEN_API_KEY=
